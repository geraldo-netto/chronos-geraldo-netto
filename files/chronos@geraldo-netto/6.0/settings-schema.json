{
    "layout": {
        "type": "layout",
        "pages": [
            "page1",
            "page2",
            "page3"
        ],
        "page1": {
            "type": "page",
            "title": "Calendar",
            "sections": [
                "section1",
                "section5",
                "section2",
                "section6",
                "section-calendar-plugins",
                "section3"
            ]
        },
        "page2": {
            "type": "page",
            "title": "World Clocks",
            "sections": [
                "section4"
            ]
        },
        "page3": {
            "type": "custom",
            "title": "About",
            "file": "settings_about.py",
            "widget": "AboutPage"
        },
        "section1": {
            "type": "section",
            "title": "Display",
            "keys": [
                "show-events",
                "show-week-numbers",
                "weekend-length",
                "custom-format",
                "custom-tooltip-format",
                "panel-font-scale",
                "format-button"
            ]
        },
        "section2": {
            "type": "section",
            "title": "Get Public Holidays for",
            "keys": [
                "country",
                "region_aus",
                "region_bel",
                "region_can",
                "region_deu",
                "region_esp",
                "region_nzl",
                "region_svk",
                "region_che",
                "region_gbr",
                "region_usa",
                "extra-country-calendars"
            ]
        },
        "section3": {
            "type": "section",
            "title": "Keyboard shortcuts",
            "keys": [
                "keyOpen"
            ]
        },
        "section6": {
            "type": "section",
            "title": "Religious Observances",
            "keys": [
                "show-religious-observances",
                "religion-christianity",
                "religion-islam",
                "religion-hinduism",
                "religion-buddhism",
                "religion-sikhism",
                "religion-judaism",
                "religion-bahai",
                "religion-jainism",
                "religion-shinto",
                "religion-taoism"
            ]
        },
        "section4": {
            "type": "section",
            "title": "Show World Times",
            "keys": [
                "show-worldclocks",
                "worldclocks"
            ]
        },
        "section5": {
            "type": "section",
            "title": "Weather and location services",
            "keys": [
                "show-weather",
                "show-astronomy",
                "weather-location",
                "openstreetmap-attribution",
                "weather-units"
            ]
        },
        "section-calendar-plugins": {
            "type": "section",
            "title": "Additional Calendars",
            "keys": [
                "calendar-plugins"
            ]
        }
    },
    "show-events": {
        "type": "switch",
        "default": true,
        "description": "Show calendar events",
        "tooltip": "Check this to display events in the calendar."
    },
    "show-week-numbers": {
        "type": "switch",
        "default": false,
        "description": "Show week numbers in calendar",
        "tooltip": "Check this to show week numbers in the calendar."
    },
    "weekend-length": {
        "type": "radiogroup",
        "default": 2,
        "description": "Mark as weekend days",
        "tooltip": "Set how many days are marked as non-working days per week.",
        "options": {
            "One day": 1,
            "Two days": 2
        }
    },
    "custom-format": {
        "type": "entry",
        "default": "%d %b %H:%M",
        "description": "Date format",
        "tooltip": "Set your custom format here."
    },
    "custom-tooltip-format": {
        "type": "entry",
        "default": "%d %b %H:%M",
        "description": "Date format for tooltip",
        "tooltip": "Set your custom tooltip format here."
    },
    "format-button": {
        "type": "button",
        "description": "Show information on date format syntax",
        "callback": "on_custom_format_button_pressed",
        "tooltip": "Click this button to know more about the syntax for date formats."
    },
    "date-format-defaults-migrated": {
        "type": "generic",
        "default": false
    },
    "show-weather": {
        "type": "switch",
        "default": false,
        "description": "Show weather on the panel",
        "tooltip": "Enable a small weather readout in the applet label. The reading is fetched from a third-party weather service, and the location below is sent to it."
    },
    "show-astronomy": {
        "type": "switch",
        "default": true,
        "description": "Show sun and moon times",
        "dependency": "show-weather",
        "tooltip": "Uses the weather location. Sunrise, sunset, moonrise, and moonset are calculated locally without an additional network request."
    },
    "weather-location": {
        "type": "custom",
        "file": "settings_widgets.py",
        "widget": "WeatherLocationEntry",
        "default": "",
        "description": "Weather location",
        "dependency": "show-weather",
        "tooltip": "City or town used for the weather lookup - for example \"Lisbon\" or \"Porto Alegre\". Leave it empty and the panel shows a bare warning marker instead of a reading. It is sent to a third-party geocoding service to find its coordinates, and then to a third-party forecast service, about every 30 minutes."
    },
    "openstreetmap-attribution": {
        "type": "button",
        "description": "\u00a9 OpenStreetMap contributors",
        "callback": "on_openstreetmap_attribution_pressed",
        "tooltip": "Open the OpenStreetMap copyright and attribution page.",
        "dependency": "show-weather"
    },
    "weather-units": {
        "type": "custom",
        "file": "settings_widgets.py",
        "widget": "OptionLabelComboBox",
        "default": "si",
        "description": "Weather units",
        "tooltip": "Temperature scale used for the panel weather readout and for the temperature beside each world clock.",
        "dependency": "show-weather",
        "options": {
            "SI (Celsius)": "si",
            "Imperial (Fahrenheit)": "imperial"
        }
    },
    "show-religious-observances": {
        "type": "switch",
        "default": false,
        "description": "Show religious observances",
        "tooltip": "Enable this, then select the religions to mark in the calendar. Observance dates come only from data bundled with the applet, and the selections never leave this computer. Observances are not marked as non-working days."
    },
    "religion-christianity": {
        "type": "custom",
        "default": false,
        "description": "Christianity",
        "dependency": "show-religious-observances",
        "indent": true,
        "file": "settings_widgets.py",
        "widget": "AvailableReligionSwitch"
    },
    "religion-islam": {
