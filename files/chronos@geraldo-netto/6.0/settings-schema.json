    "show-worldclocks": {
        "type": "switch",
        "default": true,
        "description": "Show world clocks in the calendar menu",
        "tooltip": "Uncheck to hide the world-clock rows, including the built-in UTC and local time."
    },
    "worldclocks": {
        "type": "custom",
        "description": "World Clocks",
        "dependency": "show-worldclocks",
        "tooltip": "UTC and your local time are always shown in the calendar menu; add up to 8 timezones on top of them. Type a city name and pick it from the suggestions. With weather on, each clock\u2019s timezone names a city, and that city is sent to the same third-party services as the location above.",
        "file": "settings_widgets.py",
        "widget": "ClocksList",
        "height": 288,
        "columns": [
            {
                "id": "label",
                "title": "Display name",
                "type": "string"
            },
            {
                "id": "timezone",
                "title": "Timezone",
                "type": "string"
            }
        ],
        "default": []
    },
    "panel-font-scale": {
        "type": "scale",
        "default": 1.0,
        "min": 0.8,
        "max": 1.6,
        "step": 0.05,
        "description": "Panel text size",
        "tooltip": "Multiplies the theme's panel font size. 1.0 keeps the theme's own size."
    },
    "calendar-plugins": {
        "type": "custom",
        "file": "settings_widgets.py",
        "widget": "CalendarPluginChoices",
        "default": [],
        "description": "Installed calendars",
        "tooltip": "Import local calendar JSON files, then enable the calendars to show. Only calendars covering this year are offered. Your selections stay on this computer."
