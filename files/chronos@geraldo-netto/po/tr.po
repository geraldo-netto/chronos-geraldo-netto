#: 5.4/settings_about.py:46
msgid "Primary place search and weather forecast service."
msgstr "Birincil yer arama ve hava tahmini hizmeti."

#: 5.4/settings_about.py:54
msgid ""
"Fallback place search using OpenStreetMap data. Chronos does not download "
"map tiles or other map assets."
msgstr ""
"OpenStreetMap verilerini kullanan yedek yer arama hizmeti. Chronos harita "
"döşemelerini veya diğer harita kaynaklarını indirmez."

#: 5.4/settings_about.py:63
msgid "First fallback weather service, using nearby METAR observations."
msgstr "Yakındaki METAR gözlemlerini kullanan ilk yedek hava durumu hizmeti."

#: 5.4/settings_about.py:70
msgid "Final fallback weather forecast service."
msgstr "Son yedek hava tahmini hizmeti."

#: 5.4/settings_about.py:80
msgid "Primary public-holiday service."
