#: 6.0/settings_about.py:46
msgid "Primary place search and weather forecast service."
msgstr "Primär tjänst för platssökning och väderprognoser."

#: 6.0/settings_about.py:54
msgid ""
"Fallback place search using OpenStreetMap data. Chronos does not download "
"map tiles or other map assets."
msgstr ""
"Reservtjänst för platssökning med data från OpenStreetMap. Chronos hämtar "
"inte kartplattor eller andra kartresurser."

#: 6.0/settings_about.py:63
msgid "First fallback weather service, using nearby METAR observations."
msgstr ""
"Första reservvädertjänsten, som använder närliggande METAR-observationer."

#: 6.0/settings_about.py:70
msgid "Final fallback weather forecast service."
msgstr "Sista reservtjänsten för väderprognoser."

#: 6.0/settings_about.py:80
msgid "Primary public-holiday service."
msgstr "Primär helgdagstjänst."

#: 6.0/settings_about.py:87
msgid "First fallback public-holiday service."
msgstr "Första reservtjänsten för helgdagar."

#: 6.0/settings_about.py:94
msgid "Final fallback public-holiday service."
msgstr "Sista reservtjänsten för helgdagar."

