#. 5.4->settings-schema.json->openstreetmap-attribution->description
#: 5.4/settings_about.py:37
msgid "© OpenStreetMap contributors"
msgstr "© les contributeurs d’OpenStreetMap"

#: 5.4/settings_about.py:45
msgid "Primary place search and weather forecast service."
msgstr ""
"Service principal de recherche de lieux et de prévisions météorologiques."

#: 5.4/settings_about.py:52
msgid ""
"Fallback place search using OpenStreetMap data. Chronos does not download "
"map tiles or other map assets."
msgstr ""
"Service de secours pour la recherche de lieux utilisant les données "
"OpenStreetMap. Chronos ne télécharge aucune tuile cartographique ni autre "
"ressource cartographique."

#: 5.4/settings_about.py:60
msgid "First fallback weather service, using nearby METAR observations."
msgstr ""
"Premier service météo de secours, utilisant les observations METAR à "
"proximité."

#: 5.4/settings_about.py:66
msgid "Final fallback weather forecast service."
msgstr "Dernier service de secours pour les prévisions météorologiques."

#: 5.4/settings_about.py:75
msgid "Primary public-holiday service."
msgstr "Service principal de jours fériés."

#: 5.4/settings_about.py:81
msgid "First fallback public-holiday service."
msgstr "Premier service de secours pour les jours fériés."

#: 5.4/settings_about.py:87
msgid "Final fallback public-holiday service."
msgstr "Dernier service de secours pour les jours fériés."

#: 5.4/settings_about.py:133
#, python-format
msgid "Version %s"
msgstr "Version %s"

#: 5.4/settings_about.py:140
msgid "Project website and source code"
msgstr "Site web et code source du projet"

#: 5.4/settings_about.py:141
msgid "License: GPL 2.0 or later"
msgstr "Licence : GPL 2.0 ou ultérieure"

#: 5.4/settings_about.py:177
msgid "Weather and location services"
msgstr "Services météo et de localisation"

#: 5.4/settings_about.py:179
msgid ""
"Used only when weather is enabled. A place name is sent to a geocoder, then "
"its coordinates are sent to a weather provider."
msgstr ""
"Utilisés uniquement lorsque la météo est activée. Un nom de lieu est envoyé "
"à un service de géocodage, puis ses coordonnées sont envoyées à un "
"fournisseur météo."

#: 5.4/settings_about.py:185
msgid "Holiday services"
msgstr "Services de jours fériés"

#: 5.4/settings_about.py:187
msgid ""
"Used only when holidays are enabled. The selected country, region, and "
"requested year may be sent to these providers."
msgstr ""
"Utilisés uniquement lorsque les jours fériés sont activés. Le pays, la "
"région et l’année demandée peuvent être envoyés à ces fournisseurs."

#: 5.4/settings_about.py:194
msgid "About Chronos"
msgstr "À propos de Chronos"

