#. 5.4->settings-schema.json->show-week-numbers->description
msgid "Show week numbers in calendar"
msgstr "Показывать номера недель на календаре"

#. 5.4->settings-schema.json->show-week-numbers->tooltip
msgid "Check this to show week numbers in the calendar."
msgstr "Нажмите, чтобы отображать номера недель на панели в апплете календаря."

#. 5.4->settings-schema.json->weekend-length->description
msgid "Mark as weekend days"
msgstr "Сколько выходных в неделе"

#. 5.4->settings-schema.json->weekend-length->tooltip
msgid "Set how many days are marked as non-working days per week."
msgstr "Укажите, сколько нерабочих дней в неделе."

#. 5.4->settings-schema.json->weekend-length->options
msgid "One day"
msgstr "Один день"

#. 5.4->settings-schema.json->weekend-length->options
msgid "Two days"
msgstr "Два дня"

#. 5.4->settings-schema.json->use-custom-format->description
msgid "Use a custom date format"
msgstr "Задать свой формат даты"

#. 5.4->settings-schema.json->use-custom-format->tooltip
msgid ""
"Check this to define a custom format for the date in the calendar applet."
msgstr "Задать пользовательский формат даты в апплете календаря."

#. 5.4->settings-schema.json->custom-format->description
msgid "Date format"
msgstr "Формат даты"

#. 5.4->settings-schema.json->custom-format->tooltip
msgid "Set your custom format here."
msgstr "Задайте ваш формат здесь."

#. 5.4->settings-schema.json->custom-tooltip-format->description
msgid "Date format for tooltip"
msgstr "Формат даты"

#. 5.4->settings-schema.json->custom-tooltip-format->tooltip
msgid "Set your custom tooltip format here."
msgstr "Задайте ваш формат здесь."

#. 5.4->settings-schema.json->format-button->description
msgid "Show information on date format syntax"
msgstr "Справка по формату даты"

#. 5.4->settings-schema.json->format-button->tooltip
msgid "Click this button to know more about the syntax for date formats."
msgstr "Нажмите, чтобы узнать, как указать свой формат даты."

#. 5.4->settings-schema.json->show-weather->description
msgid "Show weather on the panel"
msgstr "Показывать погоду на панели"

#. 5.4->settings-schema.json->show-weather->tooltip
msgid ""
"Enable a small weather readout in the applet label. The reading is fetched "
"from a third-party weather service, and the location below is sent to it. A "
"vertical panel has no room for the readout, so it shows only in the tooltip "
"and the popup."
msgstr ""
"Показывать небольшую сводку погоды на метке апплета. Данные запрашиваются у "
"стороннего погодного сервиса, и указанное ниже местоположение отправляется "
"ему. На вертикальной панели для сводки нет места, поэтому там она "
"показывается только во всплывающей подсказке и в меню."

#. 5.4->settings-schema.json->weather-location->description
msgid "Weather location"
msgstr "Местоположение для погоды"

#. 5.4->settings-schema.json->weather-location->tooltip
msgid ""
"City or town used for the weather lookup - for example \"Lisbon\" or \"Porto "
"Alegre\". Leave it empty and the panel shows a bare warning marker instead "
"of a reading. It is sent to a third-party geocoding service to find its "
"coordinates, and then to a third-party forecast service, about every 30 "
"minutes."
msgstr ""
"Город для запроса погоды — например, «Лиссабон» или «Порту-Алегри». Если "
"оставить поле пустым, панель покажет только предупреждающий знак вместо "
"данных. Город отправляется стороннему сервису геокодирования для определения "
"координат, а затем — стороннему сервису прогноза, примерно каждые 30 минут."

#. 5.4->settings-schema.json->weather-units->description
msgid "Weather units"
msgstr "Единицы погоды"

#. 5.4->settings-schema.json->weather-units->tooltip
msgid ""
"Temperature scale used for the panel weather readout and for the temperature "
"beside each world clock."
msgstr ""
"Шкала температуры для сводки погоды на панели и для температуры рядом с "
"каждыми мировыми часами."

#. 5.4->settings-schema.json->weather-units->options
msgid "SI (Celsius)"
msgstr "СИ (Цельсий)"

#. 5.4->settings-schema.json->weather-units->options
msgid "Imperial (Fahrenheit)"
msgstr "Имперские (Фаренгейт)"

#. 5.4->settings-schema.json->country->description
msgid "Country"
msgstr "Страна"

#. 5.4->settings-schema.json->country->tooltip
msgid ""
"Country whose public holidays are marked in the calendar. Holidays are off "
"until you pick a country: the lookup sends your country to a third-party "
"holiday service."
msgstr ""
"Страна, государственные праздники которой отмечаются в календаре. Праздники "
"отключены, пока не выбрана страна: запрос отправляет вашу страну стороннему "
"сервису праздников."

#. 5.4->settings-schema.json->country->options
msgid "None (disable holidays)"
msgstr "Нет (отключить праздники)"

