#. 5.4->settings-schema.json->section5->title
#: 5.4/settings_about.py:184
msgid "Weather and location services"
msgstr "Servicios meteorológicos y de ubicación"

#: 5.4/settings_about.py:186
msgid ""
"Used only when weather is enabled. A place name is sent to a geocoder, then "
"its coordinates are sent to a weather provider."
msgstr ""
"Solo se utilizan cuando el tiempo está activado. Se envía el nombre de un "
"lugar a un geocodificador y, después, sus coordenadas a un proveedor "
"meteorológico."

#: 5.4/settings_about.py:192
msgid "Holiday services"
msgstr "Servicios de días festivos"

#: 5.4/settings_about.py:194
msgid ""
"Used only when holidays are enabled. The selected country, region, and "
"requested year may be sent to these providers."
msgstr ""
"Solo se utilizan cuando los días festivos están activados. El país, la "
"región y el año solicitado seleccionados pueden enviarse a estos proveedores."

