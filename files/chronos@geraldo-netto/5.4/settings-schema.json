    "keyOpen": {
        "type": "keybinding",
        "description": "Show calendar",
        "default": "<Super>c",
        "tooltip": "Set keybinding(s) to show the calendar."
    },
    "show-worldclocks": {
        "type": "switch",
        "default": true,
        "description": "Show world clocks in the calendar menu",
        "tooltip": "Uncheck to hide the world-clock rows, including the built-in UTC and local time."
    },
    "worldclocks": {
        "type": "custom",
        "description": "World Clocks",
        "dependency": "show-worldclocks",
        "tooltip": "UTC and your local time are always shown in the calendar menu; add up to 8 timezones on top of them. Type a city name and pick it from the suggestions. With weather on, each clock’s timezone names a city, and that city is sent to the same third-party services as the location above.",
        "file": "settings_widgets.py",
        "widget": "ClocksList",
        "height": 288,
        "columns": [
            {
                "id": "label",
                "title": "Display name",
                "type": "string"
            },
            {
                "id": "timezone",
                "title": "Timezone",
                "type": "string"
            }
        ],
        "default": []
    }
